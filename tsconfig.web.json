{
    "extends": "@electron-toolkit/tsconfig/tsconfig.web.json",
    "include": [
        "src/renderer/src/env.d.ts",
        "src/renderer/src/**/*",
        "src/renderer/src/**/*.tsx",
        "src/preload/*.d.ts",
        "src/shared/**/*"
    ],
    "compilerOptions": {
        "allowImportingTsExtensions": true,
        "noImplicitAny": true,
        "composite": true,
        "jsx": "react-jsx",
        "paths": {
            "@renderer/*": ["./src/renderer/src/*"],
            "@shared/*": ["./src/shared/*"]
        }
    }
}
